# Previous backend (kept for rollback)
# VITE_API_BASE_URL=https://admission.callohm.com/api/v1

# Active backend — Twilio Voice Bot API (routes are served at the root, no /api/v1 prefix).
# Goes through the Vite dev proxy (see vite.config.js): the server rejects
# browser requests from localhost with "Disallowed CORS origin". Once the
# backend allows this origin, swap this for the direct URL below.
VITE_API_BASE_URL=/backend-api
# VITE_API_BASE_URL=http://192.168.0.191:7860
VITE_API_PROXY_TARGET=http://192.168.0.191:7860
# VITE_API_PROXY_TARGET=http://192.168.0.205:7860

# Optional: pin a specific agent. Left empty, the app uses the first agent
# from GET /agents/. VITE_TELEPHONY_ID is required for outbound calls —
# get it from GET /telephony-numbers.
VITE_AGENT_ID=
VITE_TELEPHONY_ID=

# Only used by the old ElevenLabs passthrough — no longer read.
# VITE_STATIC_KEY_ADMISSIONS=admi681b1fad268053f50d4
# VITE_ELEVENLABS_AGENT_ID_CONTACTS=agent_3001kq9z0z5ffbcsbfr1b2qfr8mx
# VITE_ELEVENLABS_TTS_MODEL=eleven_v3_conversational